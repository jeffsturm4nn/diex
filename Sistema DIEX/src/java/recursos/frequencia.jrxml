	<subDataset name="Table Dataset 1" uuid="a66392d0-7fb3-4368-96ad-e54abeeaf85b"/>
	<subDataset name="Table Dataset 2" uuid="45fe39ed-7958-420c-a9d5-f2dc828cc20b"/>
	<parameter name="CURSO_ID" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
     aluno.`nome` AS aluno_nome,
     curso.`titulo` AS curso_titulo,
     curso.`data_inicio` AS curso_data_inicio,
     curso.`data_termino` AS curso_data_termino,
     curso.`carga_horaria_total` AS curso_carga_horaria_total,
     servidor.`nome` AS servidor_nome,
     curso.`responsavel` AS curso_responsavel
FROM
     `curso` curso INNER JOIN `matricula` matricula ON curso.`id` = matricula.`id_curso`
     INNER JOIN `aluno` aluno ON matricula.`id_aluno` = aluno.`id`
     INNER JOIN `servidor` servidor ON curso.`responsavel` = servidor.`id`
WHERE
     aluno.`ativo` = 1
 AND servidor.`ativo` = 1
 AND curso.`id` = $P{CURSO_ID}]]>
	</queryString>
	<field name="aluno_nome" class="java.lang.String"/>
	<field name="curso_titulo" class="java.lang.String"/>
	<field name="curso_data_inicio" class="java.lang.String"/>
	<field name="curso_data_termino" class="java.lang.String"/>
	<field name="curso_carga_horaria_total" class="java.lang.String"/>
	<field name="servidor_nome" class="java.lang.String"/>
	<field name="curso_responsavel" class="java.lang.Integer"/>
